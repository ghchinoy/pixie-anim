digraph G {
    rankdir=TB;
    node [shape=box, fontname="Arial", style=filled, fillcolor=white];
    compound=true;

    subgraph cluster_ui {
        label = "UI Layer (Lit)";
        style=dashed;
        Dropzone [label="<pixie-dropzone>"];
        Extractor [label="Frame Extraction\n(MP4/GIF Decoder)"];
        Viewer [label="<pixie-viewer>"];
        
        Dropzone -> Extractor [label="File"];
    }

    subgraph cluster_wasm {
        label = "WASM Wrapper";
        WasmBindgen [label="wasm-bindgen"];
        BufferMgr [label="Talc Allocator"];
    }

    subgraph cluster_core {
        label = "Rust Core (pixie_anim_lib)";
        
        Sampler [label="Global Sampler\n(Whole Sequence)"];
        
        subgraph cluster_quant {
            label = "Quantization";
            KMeans [label="K-Means++ (Lab)"];
            PlanarConvert [label="Planar Palette\nConversion"];
            SIMD [label="SIMD Nearest Color\n(AVX2/NEON)"];
            
            KMeans -> PlanarConvert -> SIMD;
        }
        
        Zeng [label="Zeng Palette\nReordering"];
        
        Delta [label="Delta Engine\n(Fuzzy + Bounding Box)"];
        
        LZW [label="LZW Encoder\n(Lossy Neighbor Match)"];
        
        // Logical flow inside core
        Sampler -> KMeans [label="10% Pixels"];
        KMeans -> Zeng [label="Raw Palette"];
        Zeng -> Delta [label="Global Palette"];
        Delta -> LZW [label="Dithered Indices"];
    }

    Extractor -> WasmBindgen [label="RGBA Buffers"];
    WasmBindgen -> BufferMgr;
    WasmBindgen -> Sampler;
    LZW -> WasmBindgen [label="GIF Bytes"];
    WasmBindgen -> Viewer [label="Blob URL"];
}
